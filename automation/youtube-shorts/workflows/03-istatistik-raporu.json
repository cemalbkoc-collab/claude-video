    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/videos",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet"
            },
            {
              "name": "id",
              "value": "={{ ($json.rows || []).map(r => r[0]).join(',') || 'none' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fbfa926d-721d-5ba1-aa32-13baaa3874ff",
      "name": "Video başlıklarını al",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        0
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Merge daily core metrics with revenue (if the channel is monetized) into one row per\n// day for the sheet.\nconst toRows = r => (r && r.columnHeaders && r.rows)\n  ? r.rows.map(row => Object.fromEntries(r.columnHeaders.map((h, i) => [h.name, row[i]])))\n  : [];\nconst core = toRows($('Günlük kanal metrikleri').first().json);\nconst revenueResp = $('Gelir metrikleri').first().json;\nconst revenue = Object.fromEntries(toRows(revenueResp).map(r => [r.day, r]));\nconst monetized = Boolean(revenueResp && revenueResp.rows);\n\nconst rows = core.map(r => ({\n  tarih: r.day,\n  izlenme: r.views,\n  izlenme_dakika: r.estimatedMinutesWatched,\n  ort_izlenme_sn: r.averageViewDuration,\n  abone_net: (r.subscribersGained || 0) - (r.subscribersLost || 0),\n  begeni: r.likes,\n  yorum: r.comments,\n  paylasim: r.shares,\n  gelir_usd: monetized ? (revenue[r.day]?.estimatedRevenue ?? 0) : '',\n  cpm_usd: monetized ? (revenue[r.day]?.cpm ?? '') : '',\n}));\n\nreturn rows.map(r => ({ json: r }));"
      },
      "id": "6ddb3714-69eb-557a-8240-b35b1a0909ff",
      "name": "Raporu hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Rapor ayarları').first().json.sheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Rapor ayarları').first().json.sheet_name }}"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "tarih"
          ],
          "schema": []
        },
        "options": {}
      },
      "id": "e386e332-538d-5fa2-82b7-c9e0d5e0ecdf",
      "name": "Tabloya yaz",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2160,
        0
      ],
      "notes": "Aynı gün tekrar yazılırsa satır güncellenir (eşleşme sütunu: tarih)."
    },
    {
      "parameters": {
        "jsCode": "// Readable weekly summary for the execution log (or to forward to Telegram / e-mail).\nconst rows = $('Raporu hazırla').all().map(i => i.json);\nconst sum = k => rows.reduce((a, r) => a + (Number(r[k]) || 0), 0);\nconst monetized = rows.some(r => r.gelir_usd !== '');\nconst titlesResp = $('Video başlıklarını al').first().json;\nconst titles = Object.fromEntries((titlesResp.items || []).map(v => [v.id, v.snippet.title]));\nconst topResp = $('En çok izlenen videolar').first().json;\nconst top = (topResp.rows || []).slice(0, 5)\n  .map((r, i) => `${i + 1}. ${titles[r[0]] || r[0]}: ${r[1]} izlenme, %${Math.round(r[3] || 0)} izlenme oranı`);\nconst cfg = $('Tarih aralığı').first().json;\nconst ozet = [\n  `${cfg.startDate} – ${cfg.endDate}`,\n  `İzlenme: ${sum('izlenme')}  |  İzlenme süresi: ${Math.round(sum('izlenme_dakika') / 60)} saat  |  Net abone: ${sum('abone_net')}`,\n  monetized ? `Tahmini gelir: $${sum('gelir_usd').toFixed(2)}` : 'Gelir: kanal henüz para kazanmıyor veya gelir izni verilmedi',\n  'En çok izlenenler:', ...(top.length ? top : ['(veri yok)']),\n].join('\\n');\nreturn [{ json: { ozet } }];"
      },
      "id": "787672d9-4122-5626-bbae-bd76712ba7d4",
