      "id": "0677d679-f83c-5ca6-812e-347c346b9a65",
      "name": "Rapor ayarları",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ],
      "notes": "sheet_id, Google Sheets adresindeki /d/ ile /edit arasındaki kısımdır."
    },
    {
      "parameters": {
        "jsCode": "// YouTube Analytics data settles about two days late, so the window ends two days ago.\nconst cfg = $input.first().json;\nconst day = n => { const d = new Date(); d.setUTCDate(d.getUTCDate() - n); return d.toISOString().slice(0, 10); };\nreturn [{ json: { ...cfg, startDate: day(Number(cfg.days) + 1), endDate: day(2) } }];"
      },
      "id": "2c754ace-92cd-5474-9673-91d0e6351bb4",
      "name": "Tarih aralığı",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://youtubeanalytics.googleapis.com/v2/reports",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ids",
              "value": "channel==MINE"
            },
            {
              "name": "startDate",
              "value": "={{ $('Tarih aralığı').first().json.startDate }}"
            },
            {
              "name": "endDate",
              "value": "={{ $('Tarih aralığı').first().json.endDate }}"
            },
            {
              "name": "metrics",
              "value": "views,estimatedMinutesWatched,averageViewDuration,subscribersGained,subscribersLost,likes,comments,shares"
            },
            {
              "name": "dimensions",
              "value": "day"
            },
            {
              "name": "sort",
              "value": "day"
            }
          ]
        },
        "options": {}
      },
      "id": "5964b654-7bfe-57ff-b4d0-de3e0acadd91",
