      "id": "5ae07715-7d66-552a-a1ec-90f60991858a",
      "name": "Kanal kimliğini al",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/commentThreads",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet"
            },
            {
              "name": "allThreadsRelatedToChannelId",
              "value": "={{ $json.items[0].id }}"
            },
            {
              "name": "maxResults",
              "value": "50"
            },
            {
              "name": "order",
              "value": "time"
            },
            {
              "name": "textFormat",
              "value": "plainText"
            }
          ]
        },
        "options": {}
      },
      "id": "6210b871-23ca-5ae7-bf52-f7b9cd1c85d0",
      "name": "Son yorumları çek",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Keep only fresh top-level comments on our own videos that nobody has answered yet\n// and that this workflow has not already looked at. Seen IDs live in workflow static\n// data, which n8n saves only for runs of the active (published) workflow.\nconst cfg = $('Yorum ayarları').first().json;\nconst channelId = $('Kanal kimliğini al').first().json.items?.[0]?.id;\nconst seen = $getWorkflowStaticData('global');\nseen.ids = seen.ids || [];\nconst seenSet = new Set(seen.ids);\n\nconst picked = [];\nfor (const t of $input.first().json.items || []) {\n  const top = t.snippet?.topLevelComment;\n  const sn = top?.snippet;\n  if (!top || !sn) continue;\n  if (seenSet.has(top.id)) continue;\n  if (t.snippet.totalReplyCount > 0 || t.snippet.canReply === false) continue;\n  if (sn.authorChannelId?.value === channelId) continue;\n  picked.push({ commentId: top.id, videoId: t.snippet.videoId, author: sn.authorDisplayName, text: sn.textOriginal || sn.textDisplay });\n  if (picked.length >= Number(cfg.max_per_run)) break;\n}\nseen.ids = seen.ids.concat(picked.map(p => p.commentId)).slice(-2000);\nreturn picked.map(p => ({ json: p }));"
      },
      "id": "10cb1099-05d7-58a3-9958-4e69f53e6596",
      "name": "Yanıtlanacakları seç",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5-5', max_tokens: 400, system: 'Bir YouTube kanalının sahibi adına izleyici yorumlarına kısa, samimi ve doğru yanıtlar yazıyorsun. Yalnızca JSON döndür: ' + '{\"skip\": boolean, \"reason\": string, \"reply\": string}. ' + 'skip=true yap: spam, reklam, link, hakaret, siyasi tartışma, kişisel bilgi, tıbbi/hukuki/finansal tavsiye isteyen veya yanıtı kanal sahibinin bilmesi gereken bir bilgiye dayanan yorumlar. ' + 'Yanıt yorumun dilinde, en fazla 2 cümle, emoji en fazla 1 tane, link yok, abone ol/beğen çağrısı yok, bilmediğin bir şeyi uydurma. ' + 'Kanal sesi: ' + $('Yorum ayarları').first().json.persona, messages: [{ role: 'user', content: 'Yorum yazan: ' + $json.author + '\\nYorum: ' + $json.text }] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "287a4507-b27f-5d96-9f1b-beb626d0a2ff",
      "name": "Yanıt yaz (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $('Yanıtlanacakları seç').item.json;\nconst text = ($json.content || []).map(x => x.text || '').join('');\nlet r;\ntry {\n  r = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1));\n} catch (e) {\n  r = { skip: true, reason: 'Claude yanıtı JSON değildi' };\n}\nreturn { json: { ...c, skip: Boolean(r.skip) || !r.reply, reason: r.reason || '', reply: String(r.reply || '').slice(0, 500) } };"
      },
      "id": "413ef381-b562-506e-bb2a-e689c6209df5",
      "name": "Yanıtı ayrıştır",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "405f33b0-e131-529d-be7f-195b69f54371",
              "leftValue": "={{ $('Yorum ayarları').first().json.auto_reply }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "3d8b4541-aa0b-521c-825f-1135a0d4b1d2",
              "leftValue": "={{ $json.skip }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4c633dec-c7f4-50ca-b0e5-afc56974cf5f",
      "name": "Gönderilsin mi?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1920,
