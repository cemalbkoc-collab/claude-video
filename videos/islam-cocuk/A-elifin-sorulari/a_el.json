[{"row": "2", "speaker": "ELİF", "text": "Dede! Bu güzel ses ne?", "file": "/home/user/claude-video/videos/islam-cocuk/A-elifin-sorulari/assets/vo/el00.mp3", "dur": 1.83}, {"row": "4", "speaker": "ELİF", "text": "Namaz mı? Dede, biz neden namaz kılıyoruz?", "file": "/home/user/claude-video/videos/islam-cocuk/A-elifin-sorulari/assets/vo/el01.mp3", "dur": 3.45}, {"row": "7", "speaker": "ELİF", "text": "Dede, Allah bize ne yapmamızı istediğini nasıl bildirdi?", "file": "/home/user/claude-video/videos/islam-cocuk/A-elifin-sorulari/assets/vo/el02.mp3", "dur": 3.29}, {"row": "12b", "speaker": "ELİF", "text": "Dede, ben de abdest almayı öğrenebilir miyim?", "file": "/home/user/claude-video/videos/islam-cocuk/A-elifin-sorulari/assets/vo/el03.mp3", "dur": 2.81}, {"row": "14", "speaker": "ELİF", "text": "Ben de büyüyünce oruç tutacağım!", "file": "/home/user/claude-video/videos/islam-cocuk/A-elifin-sorulari/assets/vo/el04.mp3", "dur": 1.89}, {"row": "17", "speaker": "ELİF", "text": "Şehadet, namaz, oruç, zekât, hac! Beş şart!", "file": "/home/user/claude-video/videos/islam-cocuk/A-elifin-sorulari/assets/vo/el05.mp3", "dur": 3.87}, {"row": "19", "speaker": "ELİF", "text": "Esselâmü aleyküm!", "file": "/home/user/claude-video/videos/islam-cocuk/A-elifin-sorulari/assets/vo/el06.mp3", "dur": 1.35}, {"row": "23", "speaker": "ELİF", "text": "Dede, bugün çok şey öğrendim. Allah'ı seviyorum.", "file": "/home/user/claude-video/videos/islam-cocuk/A-elifin-sorulari/assets/vo/el07.mp3", "dur": 2.53}]
